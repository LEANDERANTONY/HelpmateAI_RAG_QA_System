OPENAI_API_KEY=your_openai_api_key

# Backend runtime
HELPMATE_DATA_DIR=./data
HELPMATE_UPLOADS_DIR=./data/uploads
HELPMATE_INDEXES_DIR=./data/indexes
HELPMATE_CACHE_DIR=./data/cache
HELPMATE_CORS_ORIGINS=http://localhost:3000
HELPMATE_STATE_STORE_BACKEND=local
HELPMATE_VECTOR_STORE_BACKEND=local
HELPMATE_PDF_EXTRACTOR=pypdf
HELPMATE_DOCX_EXTRACTOR=python-docx
HELPMATE_TABLE_EXTRACTOR=pdfplumber
HELPMATE_TABLE_EXTRACTOR_MAX_PAGES=40
HELPMATE_RERANKER_ENABLED=true
HELPMATE_ROUTER_LLM_ENABLED=true
HELPMATE_DOCUMENT_LANDMARKS_ENABLED=true
HELPMATE_DOCUMENT_LANDMARKS_MODEL=gpt-5.4-nano
HELPMATE_DOCUMENT_LANDMARKS_MAX_PAGES=14
HELPMATE_DOCUMENT_LANDMARKS_MAX_LANDMARKS=12
HELPMATE_DOCUMENT_LANDMARKS_MIN_CONFIDENCE=0.58
HELPMATE_CHUNK_SEMANTICS_ENABLED=true
HELPMATE_CHUNK_SEMANTICS_MODEL=gpt-5.4-nano
HELPMATE_CHUNK_SEMANTICS_MAX_REVIEW_CHUNKS=12
HELPMATE_EVIDENCE_SELECTOR_ENABLED=true
HELPMATE_EVIDENCE_SELECTOR_PRUNE=false
HELPMATE_EVIDENCE_SELECTOR_TRIGGER_WEAK_EVIDENCE=false
HELPMATE_EVIDENCE_SELECTOR_TRIGGER_SPREAD=true
HELPMATE_EVIDENCE_SELECTOR_TRIGGER_AMBIGUITY=false
HELPMATE_SUPPORT_STATUS_VERIFIER_ENABLED=true
HELPMATE_SUPPORT_STATUS_VERIFIER_MODEL=gpt-5.4-mini
HELPMATE_GLOBAL_FALLBACK_TOP_K=3
HELPMATE_PLANNER_CANDIDATE_REGION_LIMIT=10
HELPMATE_WORKSPACE_RETENTION_HOURS=24

# Optional Supabase-backed state
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
HELPMATE_SUPABASE_DOCUMENTS_TABLE=helpmate_documents
HELPMATE_SUPABASE_INDEXES_TABLE=helpmate_indexes
HELPMATE_SUPABASE_ARTIFACTS_TABLE=helpmate_index_artifacts
HELPMATE_SUPABASE_RUN_TRACES_TABLE=helpmate_run_traces
HELPMATE_SUPABASE_QUOTA_COUNTERS_TABLE=helpmate_quota_counters

# Where 402 / 413 quota responses send clients to upgrade. Default
# matches production; override in staging/dev to test against a local
# landing page.
HELPMATE_UPGRADE_URL=https://helpmateai.xyz/pricing

# Optional hosted Chroma / Chroma Cloud-style HTTP endpoint
HELPMATE_CHROMA_HTTP_HOST=localhost
HELPMATE_CHROMA_HTTP_PORT=8000
HELPMATE_CHROMA_HTTP_SSL=false
HELPMATE_CHROMA_HTTP_TENANT=default_tenant
HELPMATE_CHROMA_HTTP_DATABASE=default_database
HELPMATE_CHROMA_UPSERT_BATCH_SIZE=250
CHROMA_API_KEY=
# Comma-separated headers, for example:
# HELPMATE_CHROMA_HTTP_HEADERS=Authorization=Bearer your_token,X-Custom=value

# Frontend runtime
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_UPLOAD_API_BASE_URL=
API_REWRITE_TARGET=http://127.0.0.1:8001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Lemon Squeezy payments. All optional; leave empty until you go live.
# When unset, the pricing CTA renders as "Coming soon" and the webhook
# endpoint returns 503 (so LS retries are deferred, not lost).
# Backend secrets (server-only, must NOT be NEXT_PUBLIC_):
HELPMATE_LEMONSQUEEZY_API_KEY=
HELPMATE_LEMONSQUEEZY_WEBHOOK_SECRET=
HELPMATE_LEMONSQUEEZY_STORE_ID=
HELPMATE_LEMONSQUEEZY_PRODUCT_VARIANT_PRO=
HELPMATE_LEMONSQUEEZY_PRODUCT_VARIANT_BUSINESS=
# Frontend public values (Next.js inlines NEXT_PUBLIC_* into the JS bundle):
NEXT_PUBLIC_LEMONSQUEEZY_STORE_ID=
NEXT_PUBLIC_LEMONSQUEEZY_PRODUCT_VARIANT_PRO=
NEXT_PUBLIC_LEMONSQUEEZY_PRODUCT_VARIANT_BUSINESS=

# Observability — Sentry (error tracking + tracing) + PostHog
# (product analytics). All optional; the integrations are no-ops
# when their DSN / API key is empty, so dev environments and CI
# don't have to carry the secrets.
#
# Backend (server-only):
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Sampling rate for CPU/memory profiles per traced request. 5% keeps
# the free Developer plan quota healthy while giving Sentry enough
# data to surface slow code paths on the Performance dashboard.
SENTRY_PROFILES_SAMPLE_RATE=0.05
SENTRY_SEND_DEFAULT_PII=false
# Source-map upload via withSentryConfig (frontend/next.config.ts).
# Generate at Sentry -> Settings -> Auth Tokens with project:releases
# + project:read scopes. Vercel's official Sentry integration auto-
# provisions this; if you install that, you can leave this blank.
SENTRY_AUTH_TOKEN=
# When SENTRY_RELEASE is unset, the SDK groups events by the
# retrieval_version constant from src/config.py instead.
SENTRY_RELEASE=
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Shared label that gets attached to every Sentry issue + every
# PostHog event so we can slice prod from staging / a PR preview.
HELPMATE_ENVIRONMENT=development

# Frontend (Next.js inlines NEXT_PUBLIC_* into the JS bundle):
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
